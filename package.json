{
  "name": "reviewforge-desktop",
  "productName": "ReviewForge Desktop",
  "version": "2.1.0",
  "private": true,
  "description": "Local-first code review and feedback resolution with GitHub Copilot",
  "author": {
    "name": "Kevin Sun"
  },
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "start": "npm run build && electron .",
    "package": "npm run build && electron-forge package",
    "make": "npm run build && electron-forge make",
    "check": "npm run typecheck && npm test && npm run build",
    "make:windows": "npm run build && node scripts/package-windows.mjs"
  },
  "dependencies": {
    "@github/copilot-sdk": "^1.0.31",
    "diff": "^8.0.0",
    "dugite": "^3.0.0",
    "electron-squirrel-startup": "^1.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-markdown": "^10.0.0",
    "remark-gfm": "^4.0.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^8.0.1",
    "@electron-forge/maker-dmg": "^8.0.1",
    "@electron-forge/maker-squirrel": "^8.0.1",
    "@electron-forge/maker-zip": "^8.0.1",
    "@types/diff": "^7.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "electron": "45.2.3",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.0",
    "prettier": "^3.9.10",
    "tsx": "^4.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  },
  "config": {
    "forge": "./forge.config.cjs"
  },
  "homepage": "https://github.com/ascube/ReviewForge#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ascube/ReviewForge.git"
  },
  "bugs": {
    "url": "https://github.com/ascube/ReviewForge/issues"
  }
}
